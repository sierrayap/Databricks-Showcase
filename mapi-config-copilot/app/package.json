{
  "name": "mapi-config-app",
  "version": "1.0.0",
  "private": true,
  "description": "PGlite (in-memory Postgres) for the MAPI config app",
  "scripts": {
    "start": "pglite-server --db=memory:// --port=5433 --include-database-url --run \"streamlit run app.py\""
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19"
  }
}
